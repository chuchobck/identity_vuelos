generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  previewFeatures     = ["partialIndexes"]
  importFileExtension = ""
  moduleFormat        = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model auditoria_seguridad {
  id             BigInt              @id(map: "pk_auditoria_seguridad") @default(autoincrement())
  fecha_evento   DateTime            @default(now()) @db.Timestamptz(6)
  evento         evento_seguridad
  resultado      resultado_seguridad
  motivo         String?
  usuario_id     String?             @db.Uuid
  cliente_id     String?             @db.Uuid
  correo_parcial String?
  direccion_ip   String?             @db.Inet
  id_peticion    String?
  cliente_oauth  cliente_oauth?      @relation(fields: [cliente_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_auditoria_seguridad_cliente")
  usuario        usuario?            @relation(fields: [usuario_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_auditoria_seguridad_usuario")

  @@index([cliente_id, fecha_evento], map: "ix_auditoria_seguridad_cliente", where: raw("(cliente_id IS NOT NULL)"))
  @@index([fecha_evento], map: "ix_auditoria_seguridad_fecha")
  @@index([usuario_id, fecha_evento], map: "ix_auditoria_seguridad_usuario", where: raw("(usuario_id IS NOT NULL)"))
}

