  codigo              String                @unique(map: "uq_cliente_oauth_codigo")
  nombre              String
  hash_secreto        String
  scopes_permitidos   String[]
  activo              Boolean               @default(true)
  fecha_creacion      DateTime              @default(now()) @db.Timestamptz(6)
  fecha_actualizacion DateTime              @default(now()) @db.Timestamptz(6)
  auditoria_seguridad auditoria_seguridad[]
