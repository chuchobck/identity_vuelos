# Copia este archivo a .env y completa lo que falta. Nunca subas .env a git.
# La tabla completa de variables (obligatoria, ejemplo, qué pasa si falta) está en docs/DEPLOY.md.

# Base de datos. ?schema= elige el esquema (por defecto identidad). La de abajo es la del
# docker-compose.yml de este repo (puerto 5433, para no chocar con la base del core en el 5432).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/identity_db?schema=identidad"
NODE_ENV=development
PORT=3001
# Puerto del host para el PostgreSQL de docker-compose. Si lo cambias, cambia también DATABASE_URL.
DB_PORT=5433

# Emisor (iss) de los tokens: el origen público del servicio, sin ruta ni barra final. Obligatoria.
# En producción debe ser https. El core la compara texto a texto con el "iss" de cada token.
JWT_ISSUER=http://localhost:3001
# Audiencia (aud) de los tokens. Opcional; vale quinde-vuelos-api (lo que el core ya acepta).
JWT_AUDIENCE=quinde-vuelos-api
# Clave privada RSA (2048 bits o más) que firma los tokens: PEM en base64, en una sola línea.
# Obligatoria: sin ella el servicio no arranca. Genera una propia con "npm run keys:generate" y
# pégala aquí; nunca la subas a git.
JWT_SIGNING_KEY=
# Clave pública del par ANTERIOR (PEM en base64), solo durante una rotación: los tokens firmados
# con ella siguen verificando hasta vencer. Opcional; ver docs/DEPLOY.md, "Rotar claves".
JWT_PREVIOUS_PUBLIC_KEY=

# Orígenes que pueden llamar al servicio desde un navegador (CORS), separados por coma, sin ruta
# ni barra final y sin "*". Opcional: vacía o ausente, ningún origen de navegador puede llamar.
# Ejemplo: CORS_ORIGINS=https://quinde.example.com,http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Límite de peticiones por IP en todo el servicio: máximo por ventana y duración de la ventana en
# segundos. Opcionales; valen 100 y 60. Al pasarse, 429 con Retry-After.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60
# Proxies entre el cliente y el servicio, para que la IP del cliente (límites, auditoría) sea la
# de X-Forwarded-For y no la del proxy. false = ninguno (local); 1 = un proxy (un balanceador).
# También acepta una lista de IP, CIDR, loopback, linklocal o uniquelocal. "true" no se acepta.
TRUST_PROXY=false

# Administrador inicial que siembra ./db/reset.sh (no lo usa el servicio). Sin contraseña no se
# crea. La contraseña va solo en tu .env, nunca en git; de 12 a 128 caracteres.
SEED_ADMIN_EMAIL=admin@quinde.example
SEED_ADMIN_PASSWORD=
